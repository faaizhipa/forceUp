{
   "action": {
      "default_icon": {
         "128": "icons/ExtLogoV3.png",
         "16": "icons/ExtLogoV3.png",
         "48": "icons/ExtLogoV3.png"
      },
      "default_popup": "popup.html",
      "default_title": "Penang CoE Salesforce and Docs Extension"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [ "content_script.js" ],
         "matches": [ 
            "https://clarivateanalytics.lightning.force.com/*", 
            "https://clarivateanalytics--preprod.sandbox.lightning.force.com/*", 
            "https://scholarone.my.salesforce.com/*"
         ],
         "run_at": "document_idle"
      },
      {
         "js": [
            "content_script.js",
            "modules/debounceUtils.js",
            "modules/logger.js",
            "modules/pageIdentifier.js",
            "modules/settingsManager.js",
            "modules/customerDataManager.js",
            "modules/cacheManager.js",
            "modules/caseDataExtractor.js",
            "modules/caseCommentExtractor.js",
            "modules/casePageDataExtractor.js",
            "modules/fieldHighlighter.js",
            "modules/urlBuilder.js",
            "modules/textFormatter.js",
            "modules/keyboardShortcuts.js",
            "modules/contextMenuHandler.js",
            "modules/multiTabSync.js",
            "modules/caseCommentMemory.js",
            "modules/dynamicMenu.js",
            "modules/characterCounter.js",
            "modules/shadowTextExtractor.js",
            "modules/eventSimulator.js",
            "modules/scrollController.js",
            "modules/navigationObserver.js",
            "modules/timezoneDetector.js",
            "modules/addressTimezoneResolver.js",
            "modules/accountAddressExtractor.js",
            "modules/timezoneStorage.js",
            "modules/caseTimezoneResolver.js",
            "modules/unknownCustomerManager.js",
            "modules/caseDetailExtractor.js",
            "modules/userPreferences.js",
            "modules/timezoneUtils.js",
            "modules/configurationWarningBanner.js",
            "modules/persistentBanner.js",
            "modules/implementationStatus.js",
            "modules/flexipagePanelInjector.js",
            "content_script_exlibris.js"
         ],
         "matches": [ "https://proquestllc.lightning.force.com/*", "https://clarivate23-dev-ed.develop.my.salesforce-setup.com/*" ],
         "run_at": "document_idle",
         "css": [ 
            "modules/styles/injected-panel.css",
            "modules/styles/persistent-banner.css"
         ]
      },
      {
         "js": [
            "modules/settingsManager.js",
            "modules/highlighter.js",
            "modules/stickyNotes.js",
            "modules/bookmarkManager.js",
            "content_script_highlighter.js"
         ],
         "matches": [
            "https://support.clarivate.com/*",
            "https://knowledge.exlibrisgroup.com/*",
            "https://developers.exlibrisgroup.com/*"
         ],
         "run_at": "document_idle",
         "css": [ "modules/styles/highlighter.css" ]
      }
   ],
   "description": "Productivity Tools for Clarivate and Ex Libris",
   "icons": {
      "128": "icons/ExtLogoV3.png",
      "16": "icons/ExtLogoV3.png",
      "48": "icons/ExtLogoV3.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Penang CoE Salesforce and Docs Extension",
   "permissions": [ "storage", "tabs", "activeTab", "contextMenus" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "7.0",
   "web_accessible_resources": [
      {
         "resources": [
            "modules/styles/injected-panel.css",
            "icons/*.png"
         ],
         "matches": [
            "https://proquestllc.lightning.force.com/*",
            "https://clarivateanalytics.lightning.force.com/*",
            "https://clarivateanalytics--preprod.sandbox.lightning.force.com/*",
            "https://scholarone.my.salesforce.com/*",
            "https://clarivate23-dev-ed.develop.my.salesforce-setup.com/*"
         ]
      }
   ]
}
