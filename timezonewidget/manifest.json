{
  "manifest_version": 3,
  "name": "Global Sync Widget",
  "version": "1.0.0",
  "description": "Timezone conversion and meeting scheduling widget for cross-timezone coordination",
  
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg"
    }
  },
  
  "icons": {
    "16": "icons/icon.svg"
  },
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "modules/*.js",
        "modules/*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "modules/themeController.js",
        "modules/globalSyncStateStore.js",
        "modules/globalSyncApp.js",
        "modules/datePicker.js",
        "modules/timezoneUtils.js",
        "modules/globalSyncWidget.js",
        "content_script.js"
      ],
      "css": ["modules/globalSyncTheme.css"],
      "run_at": "document_idle"
    }
  ]
}
